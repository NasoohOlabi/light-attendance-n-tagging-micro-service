{
  "name": "light-attendance-n-tagging-micro-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "oxlint src shared manager functions tests e2e scripts neon.ts vite.config.ts playwright.config.ts",
    "test": "bun test ./tests",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "bun run test && bun run lint && bun run build && bun run check:artifact",
    "verify:ui": "vite build --mode verification && playwright test",
    "verify:release": "bun run verify && bun run security:files && bun run format:check && bun run verify:ui && bun run security:history && bun audit",
    "check:artifact": "bun scripts/check-artifact.ts",
    "setup:security": "bun scripts/setup-security.ts",
    "security:staged": "bun scripts/security.ts staged",
    "security:history": "bun scripts/security.ts history",
    "security:files": "bun scripts/security.ts files",
    "preview": "vite preview --host 127.0.0.1",
    "manager": "bun run manager/server.ts",
    "db:migrate": "bun run scripts/neon-admin.ts migrate",
    "neon:admin": "bun run scripts/neon-admin.ts",
    "verify:neon:live": "bun run scripts/verify-neon-live.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@neon/functions": "^0.11.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  }
}
