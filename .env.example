# neon deploy pulls private variables into ignored .env.local.
# Database connection strings are server/admin only; never prefix them with VITE_.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=

# Frontend hosting needs only these public endpoints. Local Vite derives them
# from the managed variables above when these overrides are absent.
# VITE_NEON_AUTH_URL=https://your-auth-host/neondb/auth
# VITE_NEON_API_URL=https://your-notebook-function-host
